# Copy to .env.local. Nothing here is needed for local development: without
# DATABASE_URL the app uses an embedded Postgres in .pglite/, and without
# RESEND_API_KEY emails are printed in the server console.
# All of these are required in production.

# PostgreSQL connection string, with the host's pooler
DATABASE_URL=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# openssl rand -base64 32 (encrypts PAN numbers; losing it makes them unreadable)
ENCRYPTION_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM="TaxPilot AI <no-reply@example.com>"

# openssl rand -base64 32 (the scheduler sends it when it starts the daily jobs)
CRON_SECRET=

# Set to true to show tax, GST and deadline figures although no chartered accountant has checked the rules yet.
# Every page then says so. Leave empty to keep them hidden.
SHOW_UNREVIEWED_RULES=

# Only for the public launch: set to true to let search engines list the site.
ALLOW_INDEXING=
